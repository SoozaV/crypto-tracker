# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.

# Base de datos local SQLite (por defecto backend/portfolio.db si se deja vacío)
# DATABASE_URL=sqlite:///./portfolio.db

# Moneda base de toda la contabilidad
BASE_CURRENCY=USDT

# --- Precios (Fase 2) ---
# CoinGecko Demo API (gratis, sin tarjeta): https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=pon_aqui_tu_demo_api_key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Moneda de cotización de CoinGecko (USDT no es fiat; se usa 'usd' como proxy ~1:1)
MARKET_VS_CURRENCY=usd

# Binance (velas OHLCV, endpoint público sin key)
BINANCE_BASE_URL=https://api.binance.com

# --- Seguridad (Fase 6) ---
# Orígenes permitidos por CORS (coma-separados). En producción pon tu dominio.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Límite de peticiones (formato slowapi). Por defecto 100/minute.
RATE_LIMIT=100/minute
